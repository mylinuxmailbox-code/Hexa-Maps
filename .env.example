# ==============================================================================
# HEXA MAPS — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `.env` for local customization. Never commit real secrets.
# ==============================================================================

# --- Server & Networking ---
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
WEB_HOST=0.0.0.0
WEB_PORT=3000
# Internal backend origin used by Next.js server-side rewrites (keeps browser URLs relative)
INTERNAL_API_ORIGIN=http://127.0.0.1:4000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database & Cache ---
# Leave DATABASE_URL unset in local sandbox mode to use embedded PGlite (PostgreSQL WASM)
# stored in apps/api/.data/pglite. Set to a PostgreSQL+PostGIS connection string in Docker/production:
# DATABASE_URL=postgresql://hexa:hexa_dev_password@localhost:5432/hexa_maps
DATABASE_URL=
PGLITE_DATA_DIR=./.data/pglite
# Optional Redis URL for distributed rate limiting & Socket.IO pub/sub scaling:
# REDIS_URL=redis://localhost:6379
REDIS_URL=

# --- Authentication & Security ---
SESSION_SECRET=replace-with-at-least-32-bytes-of-cryptographic-randomness
SESSION_TTL_DAYS=30
RATE_LIMIT_MAX_PER_MINUTE=180

# --- Basemap & Vector Tile Providers ---
# Default: "local" serves built-in OpenStreetMap + Natural Earth MVT (.pbf) vector tiles.
# Optional values: "local" | "openfreemap" | "pmtiles" | "maptiler"
NEXT_PUBLIC_DEFAULT_TILE_PROVIDER=local
NEXT_PUBLIC_PMTILES_URL=
NEXT_PUBLIC_MAPTILER_API_KEY=
# Licensed satellite imagery raster tile template (Satellite style stays disabled unless set):
# Example: https://api.maptiler.com/tiles/satellite-v2/{z}/{x}/{y}.jpg?key=YOUR_KEY
NEXT_PUBLIC_SATELLITE_TILE_URL=
NEXT_PUBLIC_SATELLITE_ATTRIBUTION=

# --- Geocoding Providers ---
# Primary order: comma-separated list from: local,photon,nominatim
GEOCODING_PROVIDERS=local,photon,nominatim
PHOTON_BASE_URL=https://photon.komoot.io
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=HexaMaps/1.0 (https://github.com/mylinuxmailbox-code/Hexa-Maps)

# --- Routing Providers ---
# Primary order: comma-separated list from: local,osrm,valhalla,otp
ROUTING_PROVIDERS=local,osrm
OSRM_BASE_URL=https://router.project-osrm.org
VALHALLA_BASE_URL=
OTP_BASE_URL=

# --- Traffic Provider ---
# "simulated" provides clearly labeled development corridor traffic.
# Set TOMTOM_API_KEY and TRAFFIC_PROVIDER=tomtom for live TomTom flow feeds.
TRAFFIC_PROVIDER=simulated
TOMTOM_API_KEY=

# --- Street-Level Imagery ---
# Optional Mapillary v4 client token for live street-level imagery frames
MAPILLARY_ACCESS_TOKEN=
NEXT_PUBLIC_MAPILLARY_ENABLED=true
